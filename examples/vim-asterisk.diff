+    " CJK run returned by cword.nvim), so wrapping would fail with E486.
+    return printf((a:config.is_whole && a:cword =~# '\k' && strlen(a:cword) == strchars(a:cword) ? '\<%s\>' : '%s'), a:cword)
 endfunction
 
