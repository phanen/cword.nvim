+" @return cword: String
+" Prefer cword.nvim's CJK-aware `get_cword()` so that CJK runs (e.g.
+" "你好") are matched whole instead of one character at a time. Fall back
+" to the built-in `expand('<cword>')` when cword.nvim is not loaded.
+function! s:get_cword() abort
+    if !exists('*luaeval')
+        return expand('<cword>')
+    endif
+    try
+        let result = luaeval('require("cword").get_cword()')
+        if type(result) is# v:t_string
+            return result
+        endif
+    catch
+    endtry
+    return expand('<cword>')
+endfunction
+
